{
  "name": "sift-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "An offline background file converter for Windows and macOS. Drag, Shift, drop.",
  "author": "Sift contributors",
  "main": "src/main.cjs",
  "scripts": {
    "setup": "node node_modules/electron/install.js",
    "start": "electron .",
    "pretest": "node scripts/build-native.cjs",
    "test": "node --test tests/*.test.cjs",
    "pretest:desktop": "node scripts/build-native.cjs",
    "test:desktop": "electron tests/background.electron.cjs",
    "package": "node scripts/package.cjs",
    "package:dir": "node scripts/package.cjs --dir",
    "check:package": "node scripts/package.cjs --check",
    "build:native": "node scripts/build-native.cjs",
    "prestart": "node scripts/build-native.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "bmp-js": "0.1.0",
    "docx": "9.13.0",
    "elheif": "0.1.0",
    "exifr": "7.1.3",
    "ffmpeg-static": "5.3.0",
    "heic-decode": "2.1.0",
    "koffi": "2.14.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "license": "GPL-3.0-or-later"
}
